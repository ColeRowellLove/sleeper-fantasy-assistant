{
  "regions": ["pdx1"],
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] || git diff --quiet HEAD^ HEAD -- .",
  "git": {
    "deploymentEnabled": {
      "develop": false,
      "feature/*": false,
      "bugfix/*": false,
      "chore/*": false,
      "docs/*": false,
      "refactor/*": false,
      "test/*": false,
      "hotfix/*": false,
      "claude/*": false,
      "dependabot/*": false,
      "release-drafter/*": false
    }
  }
}
